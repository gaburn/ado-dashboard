<#
.SYNOPSIS
    Example triage script — fetches work items from ADO board columns and outputs JSON.

.DESCRIPTION
    This is a template script.  Copy it, fill in your area paths and team names,
    then point wip-dashboard at your copy via "triage_script_path" in config.json
    or the TRIAGE_SCRIPT_PATH environment variable.

    CONTRACT — what wip-dashboard expects:
      Input  : CLI parameters described below.
      Output : A single JSON array on stdout (status lines must go to stderr).
               Each element must have the fields listed in the OUTPUT section.
               Non-JSON lines before or after the array are tolerated and stripped.

    OUTPUT SCHEMA (one object per work item):
      {
        "id":           <int>      — work item ID
        "title":        <string>   — work item title
        "board":        <string>   — board identifier (e.g. "my-board")
        "description":  <string>   — HTML-stripped description, max 500 chars
        "createdDate":  <string>   — "YYYY-MM-DD"
        "ageDays":      <int>      — calendar days since creation (-1 if unknown)
        "assignedTo":   <string>   — display name or "Unassigned"
        "prId":         <int|null> — PR number from description, or null
        "tags":         <string>   — semicolon-separated tags (may be empty)
        "priority":     <int|null> — ADO priority (1-4), or null
        "workItemType": <string>   — e.g. "Bug", "Task", "User Story"
      }

.PARAMETER Board
    Which board to query.  Defaults to the first key in $BoardConfig.

.PARAMETER Team
    Team display name from an ADO board URL (alternative to -Board).

.PARAMETER BoardColumn
    The board column to query.  Defaults to 'Triage'.

.PARAMETER ThrottleLimit
    Maximum parallel work item fetches.  Defaults to 8.

.EXAMPLE
    .\Get-TriageItems.ps1.example -Board myboard -BoardColumn Triage
    .\Get-TriageItems.ps1.example -Team 'My Team Name'
#>
[CmdletBinding()]
param(
    [string]$Board = '',
    [string]$Team = '',
    [string]$BoardColumn = 'Triage',
    [int]$ThrottleLimit = 8
)

$ErrorActionPreference = 'Stop'

# ---------------------------------------------------------------------------
# CONFIGURE YOUR BOARDS HERE
# Replace the placeholders with your actual ADO area paths and team names.
# ---------------------------------------------------------------------------
$BoardConfig = @{
    # Add one entry per board.  The key becomes the -Board argument.
    myboard = @{
        AreaPath    = "<YOUR_PROJECT>\<YOUR_AREA_PATH>"
        DisplayName = "<Your Team Display Name>"
    }
    # Example of a second board:
    # anotherboard = @{
    #     AreaPath    = "<YOUR_PROJECT>\<ANOTHER_AREA_PATH>"
    #     DisplayName = "<Another Team Display Name>"
    # }
}

# Map team display names (from board URLs) to board config keys.
$TeamNameMap = @{
    "<Your Team Display Name>" = "myboard"
}

# ---------------------------------------------------------------------------
# ADO defaults — set your org and project here.
# ---------------------------------------------------------------------------
$ADO_ORG     = "<YOUR_ORG>"       # e.g. "contoso"
$ADO_PROJECT = "<YOUR_PROJECT>"   # e.g. "MyProject"

# ---------------------------------------------------------------------------
# Script body — you should not need to change anything below this line.
# ---------------------------------------------------------------------------

# Resolve which boards to query
if ($Team) {
    if ($TeamNameMap.ContainsKey($Team)) {
        $boardsToQuery = @($TeamNameMap[$Team])
    } else {
        [Console]::Error.WriteLine("Unknown team '$Team'. Known teams: $($TeamNameMap.Keys -join ', ')")
        Write-Output '[]'
        exit 0
    }
} elseif ($Board -eq 'all') {
    $boardsToQuery = @($BoardConfig.Keys)
} elseif ($Board -and $BoardConfig.ContainsKey($Board)) {
    $boardsToQuery = @($Board)
} else {
    # Default to the first configured board
    $boardsToQuery = @($BoardConfig.Keys | Select-Object -First 1)
}

az devops configure --defaults "organization=https://dev.azure.com/$ADO_ORG" "project=$ADO_PROJECT" 2>$null

$allItems = @()
$boardCounts = @{}

foreach ($boardKey in $boardsToQuery) {
    $areaPath    = $BoardConfig[$boardKey].AreaPath
    $displayName = $BoardConfig[$boardKey].DisplayName

    [Console]::Error.WriteLine("Querying '$BoardColumn' on $displayName...")

    $wiql = "SELECT [System.Id] FROM WorkItems WHERE [System.TeamProject] = '$ADO_PROJECT' AND [System.AreaPath] = '$areaPath' AND [System.BoardColumn] = '$BoardColumn' ORDER BY [Microsoft.VSTS.Common.Priority] ASC, [System.CreatedDate] ASC"

    $rawOutput = az boards query --wiql $wiql --output json 2>&1
    try {
        $queryResult = $rawOutput | ConvertFrom-Json
    } catch {
        [Console]::Error.WriteLine("  Error querying ${displayName}: ${rawOutput}")
        $boardCounts[$displayName] = 0
        continue
    }

    if (-not $queryResult -or $queryResult.Count -eq 0) {
        [Console]::Error.WriteLine("  No items found in '$BoardColumn' on $displayName.")
        $boardCounts[$displayName] = 0
        continue
    }

    $ids = $queryResult | ForEach-Object { $_.fields.'System.Id' }
    [Console]::Error.WriteLine("  Found $($ids.Count) items. Fetching details in parallel...")
    $boardCounts[$displayName] = $ids.Count

    $tempDir = Join-Path $env:TEMP "triage-script\$boardKey"
    if (-not (Test-Path $tempDir)) { New-Item -ItemType Directory -Path $tempDir -Force | Out-Null }

    $ids | ForEach-Object -Parallel {
        $dir = $using:tempDir
        $allOutput = az boards work-item show --id $_ --output json 2>&1
        $stdoutLines = $allOutput | Where-Object { $_ -isnot [System.Management.Automation.ErrorRecord] }
        $jsonText = ($stdoutLines -join "`n").Trim()
        if ($jsonText -and $jsonText.StartsWith('{')) {
            $jsonText | Out-File (Join-Path $dir "wi_$_.json") -Encoding utf8
        } else {
            [Console]::Error.WriteLine("WARNING: Failed to fetch work item ${_}: ${jsonText}")
        }
    } -ThrottleLimit $ThrottleLimit

    $env:TRIAGE_BOARD = $boardKey

    $pythonScript = @"
import json, re, os, glob
from datetime import datetime, timezone

temp_dir = r'$tempDir'
board_key = os.environ.get('TRIAGE_BOARD', 'unknown')
now = datetime.now(timezone.utc)
items = []

for filepath in sorted(glob.glob(os.path.join(temp_dir, 'wi_*.json'))):
    try:
        with open(filepath, 'r', encoding='utf-8') as f:
            data = json.load(f)
        fields = data.get('fields', {})
        wid = fields.get('System.Id')
        title = fields.get('System.Title', '')
        desc = fields.get('System.Description', '')
        desc = re.sub(r'<[^>]+>', ' ', str(desc))
        desc = re.sub(r'&nbsp;|&quot;|&amp;|&#\d+;', ' ', desc)
        desc = re.sub(r'\s+', ' ', desc).strip()

        created_raw = fields.get('System.CreatedDate', '')
        created_date = created_raw[:10]
        try:
            age_days = (now - datetime.fromisoformat(created_raw.replace('Z', '+00:00'))).days
        except:
            age_days = -1

        assigned = fields.get('System.AssignedTo', {})
        if isinstance(assigned, dict):
            assigned = assigned.get('displayName', 'Unassigned')
        else:
            assigned = 'Unassigned'

        pr_matches = re.findall(r'(?:PR\s*#?\s*|Pull\s*Request\s*)(\d{7,8})', desc)
        pr_id = int(pr_matches[0]) if pr_matches else None

        tags = fields.get('System.Tags', '')
        priority = fields.get('Microsoft.VSTS.Common.Priority')
        work_item_type = fields.get('System.WorkItemType', '')

        items.append({
            'id': wid,
            'title': title,
            'board': board_key,
            'description': desc[:500],
            'createdDate': created_date,
            'ageDays': age_days,
            'assignedTo': assigned,
            'prId': pr_id,
            'tags': tags,
            'priority': priority,
            'workItemType': work_item_type
        })
    except Exception as e:
        import sys
        print(f'Warning: Failed to parse {filepath}: {e}', file=sys.stderr)

print(json.dumps(items, indent=2))
"@

    $pythonScript | Out-File (Join-Path $tempDir "parse.py") -Encoding utf8
    $pyStderr = $null
    $boardJson = python (Join-Path $tempDir "parse.py") 2>&1 | ForEach-Object {
        if ($_ -is [System.Management.Automation.ErrorRecord]) {
            $pyStderr += $_.ToString() + "`n"
        } else {
            $_
        }
    }
    if ($pyStderr) {
        [Console]::Error.WriteLine("  Python warnings: $pyStderr")
    }
    $boardItems = $boardJson | ConvertFrom-Json
    if ($boardItems) {
        $allItems += $boardItems
    }

    Remove-Item (Join-Path $tempDir "wi_*.json") -Force 2>$null
    Remove-Item (Join-Path $tempDir "parse.py") -Force 2>$null
    Remove-Item $tempDir -Force -Recurse 2>$null
}

$jsonOutput = $allItems | ConvertTo-Json -Depth 10 -AsArray
Write-Output $jsonOutput

$totalCount = $allItems.Count
$summary = ($boardCounts.GetEnumerator() | ForEach-Object { "$($_.Value) from $($_.Key)" }) -join ', '
[Console]::Error.WriteLine("Done. $totalCount items total ($summary).")
