/* ============================================================================
 *  WIP Dashboard — Textual CSS
 *  A professional dark-theme TUI for Azure DevOps PRs & Work Items
 *
 *  Palette
 *  ───────
 *  Accent (ADO blue) .... #0078d4
 *  Accent bright ........ #1a8fea
 *  Surface .............. #1e1e1e
 *  Surface raised ....... #252526
 *  Surface overlay ...... #2d2d30
 *  Border subtle ........ #3e3e42
 *  Text primary ......... #cccccc
 *  Text muted ........... #848488
 *  Approved / success ... #2ea043
 *  Rejected / danger .... #da3633
 *  Waiting / warning .... #d29922
 *  Bug .................. #e5534b
 *  Task ................. #c9a227
 *  Story ................ #3fb950
 *  Deliverable .......... #a371f7
 * ========================================================================= */


/* ---------------------------------------------------------------------------
 *  VARIABLES
 * ------------------------------------------------------------------------- */

$accent: #0078d4;
$accent-bright: #1a8fea;
$surface: #1e1e1e;
$surface-raised: #252526;
$surface-overlay: #2d2d30;
$border-subtle: #3e3e42;
$text-primary: #cccccc;
$text-muted: #848488;
$approved-color: #2ea043;
$rejected-color: #da3633;
$waiting-color: #d29922;


/* ---------------------------------------------------------------------------
 *  GLOBAL DEFAULTS
 * ------------------------------------------------------------------------- */

Screen {
    background: $surface;
    color: $text-primary;
    overflow-y: auto;
}

* {
    scrollbar-background: $surface-raised;
    scrollbar-color: $border-subtle;
    scrollbar-color-hover: $text-muted;
    scrollbar-color-active: $accent;
}


/* ---------------------------------------------------------------------------
 *  HEADER & FOOTER
 * ------------------------------------------------------------------------- */

Header {
    background: $accent;
    color: #ffffff;
    dock: top;
    text-style: bold;
}

Footer {
    background: $surface-raised;
    color: $text-muted;
    dock: bottom;
}

Footer > .footer--key {
    background: $accent;
    color: #ffffff;
    text-style: bold;
}

Footer > .footer--description {
    color: $text-primary;
}


/* ---------------------------------------------------------------------------
 *  DASHBOARD SCREEN
 * ------------------------------------------------------------------------- */

#dashboard-screen {
    layout: vertical;
    width: 100%;
    height: 100%;
    background: $surface;
}


/* ---------------------------------------------------------------------------
 *  TABBED CONTENT  &  TABS
 *
 *  IMPORTANT — Textual uses a border-box model: the CSS `height` property
 *  includes padding + border.  Tab's DEFAULT_CSS sets `height: 1`, so any
 *  vertical padding MUST be accounted for by also setting an explicit height
 *  (or using `height: auto`).  Without that, the content area shrinks to
 *  zero and text becomes invisible regardless of its color.
 * ------------------------------------------------------------------------- */

TabbedContent {
    width: 100%;
    height: 1fr;
    background: $surface;
}

Tabs {
    background: $surface-raised;
    width: 100%;
    height: auto;       /* auto-size to fit tab content + underline */
    max-height: 5;      /* cap expansion: 1 pad + 1 text + 1 pad + 1 underline = 4 rows */
    dock: top;
}

Tab {
    background: $surface-raised;
    color: #969696;
    height: auto;       /* auto-size: 1 row content + vertical padding */
    padding: 1 3;
    text-style: none;
}

Tab:hover {
    color: $text-primary;
    background: $surface-overlay;
    text-style: none;
}

Tab:focus {
    color: #969696;
    background: $surface-raised;
    text-style: none;
}

Tab.-active {
    color: #ffffff;
    background: $surface;
    text-style: bold;
}

Tab.-active:hover {
    color: #ffffff;
    background: $surface;
    text-style: bold;
}

Tab.-active:focus {
    color: #ffffff;
    background: $surface;
    text-style: bold;
}

Underline > .underline--bar {
    color: $border-subtle;
}

Underline > .-active {
    color: $accent;
}

TabPane {
    width: 1fr;
    height: 1fr;
    padding: 0 2;
    background: #1e1e1e;
}

ContentSwitcher {
    width: 100%;
    height: 1fr;
}


/* ---------------------------------------------------------------------------
 *  DATA TABLES  —  shared styles
 * ------------------------------------------------------------------------- */

DataTable {
    width: 1fr;
    height: 1fr;
    background: $surface;
    color: $text-primary;
    scrollbar-background: $surface;
}

DataTable > .datatable--header {
    background: $surface-raised;
    color: $accent-bright;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $accent;
    color: #ffffff;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $surface-overlay;
    color: $text-primary;
}

DataTable > .datatable--even-row {
    background: $surface;
    color: $text-primary;
}

DataTable > .datatable--odd-row {
    background: $surface-raised;
    color: $text-primary;
}

DataTable > .datatable--header-cursor {
    background: $accent;
    color: #ffffff;
    text-style: bold;
}

DataTable > .datatable--header-hover {
    background: $surface-overlay;
    color: $accent-bright;
    text-style: bold;
}

DataTable > .datatable--fixed {
    background: $surface-raised;
    color: $text-primary;
}

DataTable > .datatable--fixed-cursor {
    background: $accent;
    color: #ffffff;
    text-style: bold;
}


/* --- Per-table tweaks (if needed) --- */

#pr-table {
    width: 1fr;
    height: 1fr;
}

#reviewing-table {
    width: 1fr;
    height: 1fr;
}

#work-items-table {
    width: 1fr;
    height: 1fr;
}


/* ---------------------------------------------------------------------------
 *  DETAIL SCREEN
 * ------------------------------------------------------------------------- */

#detail-screen {
    layout: vertical;
    width: 100%;
    height: 100%;
    background: $surface;
    overflow-y: auto;
    padding: 1 3;
}

#detail-screen > Vertical {
    width: 100%;
    height: auto;
    padding: 0 1;
}


/* --- Section Headings --- */

.section-heading {
    color: $accent-bright;
    text-style: bold;
    width: 100%;
    padding: 1 0 0 0;
    margin: 1 0 0 0;
    border-bottom: solid $border-subtle;
}


/* --- Field Label / Value Pairs --- */

.field-label {
    color: $text-muted;
    text-style: italic;
    width: 100%;
    padding: 0 0 0 2;
    margin: 0;
}

.field-value {
    color: $text-primary;
    text-style: none;
    width: 100%;
    padding: 0 0 0 4;
    margin: 0 0 1 0;
}


/* ---------------------------------------------------------------------------
 *  REVIEWER VOTE BADGES
 * ------------------------------------------------------------------------- */

.reviewer-approved {
    color: $approved-color;
    text-style: bold;
    padding: 0 0 0 4;
}

.reviewer-rejected {
    color: $rejected-color;
    text-style: bold;
    padding: 0 0 0 4;
}

.reviewer-waiting {
    color: $waiting-color;
    text-style: none;
    padding: 0 0 0 4;
}

.reviewer-none {
    color: $text-muted;
    text-style: dim;
    padding: 0 0 0 4;
}


/* ---------------------------------------------------------------------------
 *  URL LINK
 * ------------------------------------------------------------------------- */

.url-link {
    color: $accent-bright;
    text-style: bold underline;
    width: 100%;
    padding: 1 0 0 2;
    margin: 1 0 2 0;
}

.url-link:hover {
    color: #ffffff;
    background: $accent;
}


/* ---------------------------------------------------------------------------
 *  DRAFT INDICATOR
 * ------------------------------------------------------------------------- */

.draft-indicator {
    color: $waiting-color;
    text-style: bold;
    padding: 0 1;
}


/* ---------------------------------------------------------------------------
 *  WORK-ITEM TYPE COLORS
 * ------------------------------------------------------------------------- */

.work-item-bug {
    color: #e5534b;
    text-style: bold;
}

.work-item-task {
    color: #c9a227;
    text-style: bold;
}

.work-item-story {
    color: #3fb950;
    text-style: bold;
}

.work-item-deliverable {
    color: #a371f7;
    text-style: bold;
}


/* ---------------------------------------------------------------------------
 *  LOADING STATE
 * ------------------------------------------------------------------------- */

.loading-container {
    width: 100%;
    height: 100%;
    align: center middle;
    content-align: center middle;
    background: $surface;
}

LoadingIndicator {
    width: auto;
    height: auto;
    color: $accent;
    background: $surface;
}


/* ---------------------------------------------------------------------------
 *  EMPTY STATE
 * ------------------------------------------------------------------------- */

.empty-message {
    width: 100%;
    height: 100%;
    content-align: center middle;
    color: $text-muted;
    text-style: italic;
    padding: 3 0;
}


/* ---------------------------------------------------------------------------
 *  SCROLLABLE CONTAINERS
 * ------------------------------------------------------------------------- */

VerticalScroll {
    width: 100%;
    height: 1fr;
}

Horizontal {
    width: 100%;
    height: auto;
}

Vertical {
    width: 100%;
    height: auto;
}


/* ---------------------------------------------------------------------------
 *  TRIAGE — Grouped Priority View
 *
 *  Layout:  #triage-scroll  ▸  Collapsible (.triage-pN)  ▸  DataTable (#triage-pN)
 *  Each priority band gets a colour-coded header and a left-edge accent stripe
 *  so operators can triage at a glance.
 * ------------------------------------------------------------------------- */


/* --- Scroll container --- */

#triage-scroll {
    width: 100%;
    height: 1fr;
    background: $surface;
}


/* --- Board selector dropdown --- */

#triage-board-select {
    width: 40;
    margin: 0 0 1 1;
    background: $surface-raised;
    color: $text-primary;
    border: tall $border-subtle;
}

#triage-board-select:focus {
    border: tall $accent;
}


/* --- Collapsible group (shared) --- */

#triage-scroll Collapsible {
    width: 100%;
    background: $surface;
    margin: 0 0 1 0;
    border-left: tall $border-subtle;
    padding: 0;
}


/* --- Collapsible header (shared base) --- */

#triage-scroll CollapsibleTitle {
    background: $surface-raised;
    color: $text-primary;
    text-style: bold;
    padding: 1 2;
    width: 100%;
}

#triage-scroll CollapsibleTitle:hover {
    background: $surface-overlay;
}

#triage-scroll CollapsibleTitle:focus {
    background: $surface-overlay;
}


/* --- P1 — Critical  🔴 --- */

.triage-p1 {
    border-left: tall #da3633;
}

.triage-p1 > CollapsibleTitle {
    color: #da3633;
}


/* --- P2 — High  🟠 --- */

.triage-p2 {
    border-left: tall #d29922;
}

.triage-p2 > CollapsibleTitle {
    color: #d29922;
}


/* --- P3 — Medium  🟡 --- */

.triage-p3 {
    border-left: tall #c9a227;
}

.triage-p3 > CollapsibleTitle {
    color: #c9a227;
}


/* --- P4 — Low  ⚪ --- */

.triage-p4 {
    border-left: tall $border-subtle;
}

.triage-p4 > CollapsibleTitle {
    color: $text-muted;
    text-style: bold dim;
}


/* --- Per-group DataTables --- */

#triage-p1,
#triage-p2,
#triage-p3,
#triage-p4 {
    width: 100%;
    height: auto;
    max-height: 20;
    background: $surface;
}


/* --- Empty-state message --- */

#triage-scroll .triage-empty {
    width: 100%;
    height: auto;
    min-height: 5;
    content-align: center middle;
    color: $text-muted;
    text-style: italic;
    padding: 3 0;
    background: $surface;
}


/* ---------------------------------------------------------------------------
 *  AI STATUS INDICATOR
 *
 *  A small inline notification widget that signals whether AI analysis is
 *  in-flight or complete.  Deliberately quiet — muted italic text keeps
 *  the eye on the data, not the chrome.
 * ------------------------------------------------------------------------- */

.ai-status {
    width: 100%;
    height: auto;
    color: $text-muted;
    text-style: italic;
    padding: 0 2;
    margin: 1 0 0 0;
    background: $surface;
}


/* ---------------------------------------------------------------------------
 *  RECOMMENDED ACTION PLAN
 *
 *  Rendered as a Static widget inside #triage-scroll, below the priority
 *  group tables, once AI analysis completes.  The accent left-border ties
 *  it visually to "system intelligence" while distinguishing it from the
 *  priority-coloured collapsibles above.
 * ------------------------------------------------------------------------- */

.action-plan {
    width: 100%;
    height: auto;
    background: $surface-raised;
    color: $text-primary;
    text-style: none;
    padding: 1 2;
    margin: 1 0 0 0;
    border-left: tall $accent-bright;
}


/* ---------------------------------------------------------------------------
 *  GLOBAL STATUS BAR
 *
 *  Persistent bar between the TabbedContent and Footer showing item counts
 *  across all tabs (My PRs, Reviewing, Work Items, Triage breakdown).
 * ------------------------------------------------------------------------- */

#status-bar {
    width: 100%;
    height: 1;
    padding: 0 2;
    content-align: right middle;
    text-align: right;
    color: #848488;
    background: #252526;
    text-style: bold;
}

/* ---------------------------------------------------------------------------
 *  SESSIONS TAB
 *
 *  Active Copilot CLI sessions.  Active/inactive state is styled with Rich
 *  Text objects in Python (green/dim), so only layout rules live here.
 * ------------------------------------------------------------------------- */

/* Sessions table */
#sessions-table {
    width: 1fr;
    height: 1fr;
    background: $surface;
}


/* ---------------------------------------------------------------------------
 *  SETTINGS SCREEN
 *
 *  A simple form layout for editing configuration fields.
 *  Labels sit above inputs; a centred button row anchors the bottom.
 * ------------------------------------------------------------------------- */

#settings-form {
    width: 100%;
    height: 100%;
    background: $surface;
    padding: 1 3;
}

#settings-form Label {
    width: 100%;
    color: $text-muted;
    text-style: italic;
    padding: 0 0 0 2;
    margin: 1 0 0 0;
}

#settings-form Input {
    width: 100%;
    margin: 0 0 0 2;
}

#settings-form Switch {
    margin: 0 0 0 2;
}

.settings-buttons {
    width: 100%;
    height: auto;
    align: center middle;
    padding: 2 0 0 0;
}

.settings-buttons Button {
    margin: 0 2;
}

/* --- Triage Board Editor --- */

#boards-list {
    width: 100%;
    height: auto;
    padding: 0 0 0 2;
}

.board-row {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

#settings-form .board-name-input {
    width: 25%;
    margin: 0 1 0 0;
}

#settings-form .board-url-input {
    width: 65%;
    margin: 0 1 0 0;
}

.board-remove-btn {
    width: 5;
    min-width: 5;
}

#add-board {
    margin: 0 0 1 2;
    width: auto;
}


/* ---------------------------------------------------------------------------
 *  SEARCH BAR
 *
 *  Inline search input toggled with a keybinding.  The accent border draws
 *  the eye so the operator knows the bar is active; the `.hidden` class
 *  collapses it entirely when dismissed.
 * ------------------------------------------------------------------------- */

#search-input {
    width: 100%;
    height: auto;
    background: $surface-raised;
    color: $text-primary;
    border: tall $accent;
    padding: 0 2;
    margin: 0;
}

#search-input.hidden {
    display: none;
}
